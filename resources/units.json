{
  "layers": 4,
  "prepare": {
    "windows": [
      "autocrlf"
    ],
    "arm64": [
      "musl"
    ]
  },
  "units": {
    "binary": {
      "action": "binary",
      "verb": "build",
      "object": "binary",
      "per": "target",
      "prepare": [
        "snapshot",
        "rust",
        "node",
        "pnpm"
      ]
    },
    "suite": {
      "action": "suite",
      "verb": "test",
      "object": "suite",
      "per": "target",
      "prepare": [
        "snapshot",
        "rust",
        "node",
        "pnpm"
      ]
    },
    "suite-node": {
      "action": "node-suite",
      "verb": "test",
      "object": "suite node",
      "prepare": [
        "snapshot",
        "rust",
        "node",
        "pnpm"
      ]
    },
    "pack-npm": {
      "action": "npm-pack",
      "verb": "build",
      "object": "npm",
      "prepare": [
        "snapshot",
        "rust",
        "node",
        "pnpm"
      ]
    },
    "bind": {
      "action": "bind",
      "verb": "bind",
      "object": "binaries",
      "prepare": [
        "rcodesign"
      ]
    },
    "smoke": {
      "action": "smoke",
      "verb": "smoke",
      "object": "binary",
      "per": "target"
    },
    "validate": {
      "action": "validate",
      "verb": "validate",
      "object": "binary"
    },
    "deb": {
      "action": "deb",
      "verb": "build",
      "object": "deb"
    },
    "verify-deb": {
      "action": "deb-verify",
      "verb": "verify",
      "object": "deb"
    },
    "apk": {
      "action": "apk",
      "verb": "build",
      "object": "apk"
    },
    "verify-apk": {
      "action": "apk-verify",
      "verb": "verify",
      "object": "apk",
      "runner": "ubuntu-24.04-arm"
    }
  }
}
